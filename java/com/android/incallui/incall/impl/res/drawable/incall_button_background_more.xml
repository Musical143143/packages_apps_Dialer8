<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_card_top">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:startColor="#D9FFFFFF"
                        android:endColor="#B3E2E8F0"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/glass_text_primary" />
                    <size android:width="68dp" android:height="68dp" />
                </shape>
            </item>
            <item android:state_selected="true">
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:startColor="#D9FFFFFF"
                        android:endColor="#B3E2E8F0"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/glass_text_primary" />
                    <size android:width="68dp" android:height="68dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="135"
                        android:startColor="#38FFFFFF"
                        android:centerColor="#24FFFFFF"
                        android:endColor="#16FFFFFF"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/glass_card_stroke" />
                    <size android:width="68dp" android:height="68dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

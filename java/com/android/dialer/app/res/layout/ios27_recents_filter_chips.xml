<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ios27_recents_filter_bar"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_ios27_filter_pill_container"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView
        android:id="@+id/ios27_filter_all"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/bg_ios27_filter_pill_active"
        android:gravity="center"
        android:text="All"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ios27_filter_missed"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Missed"
        android:textColor="#B8FFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ios27_filter_voicemail"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Voicemail"
        android:textColor="#B8FFFFFF"
        android:textSize="13sp" />
</LinearLayout>

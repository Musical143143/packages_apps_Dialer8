<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF090D1A"
                android:centerColor="#FF11182B"
                android:endColor="#FF0B1020"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.7"
                android:centerY="0.55"
                android:gradientRadius="260dp"
                android:startColor="#44C27838"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>

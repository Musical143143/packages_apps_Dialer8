<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_pressed">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/glass_card_top"
                android:endColor="@color/glass_card_bottom" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/glass_card_stroke" />
        </shape>
    </item>
</ripple>

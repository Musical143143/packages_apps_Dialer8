<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass settings row. Keeps the standard androidx preference ids so the
     Preference API (title, summary, icon, widget) works unchanged. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/glass_card_pressed">

  <FrameLayout
      android:id="@android:id/icon_frame"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:minWidth="40dp">
    <ImageView
        android:id="@android:id/icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/glass_text_secondary" />
  </FrameLayout>

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="16dp"
      android:orientation="vertical">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/glass_text_primary"
        android:textSize="16sp"
        android:fontFamily="@*android:string/config_bodyFontFamily" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="@color/glass_text_secondary"
        android:textSize="14sp"
        android:fontFamily="@*android:string/config_bodyFontFamily" />
  </LinearLayout>

  <FrameLayout
      android:id="@android:id/widget_frame"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="vertical" />
</LinearLayout>
